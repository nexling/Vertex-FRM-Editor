{
  "name": "vertex-frm-preview",
  "displayName": "Vertex FRM",
  "description": "Vertex FRM form files: live preview and editing, syntax colours, completion, hover help and diagnostics",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "null"
  },
  "publisher": "Emil-TTM",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "contributes": {
    "languages": [
      {
        "id": "vertexfrm",
        "aliases": [
          "Vertex FRM",
          "vertexfrm"
        ],
        "extensions": [
          ".frm",
          ".vxf",
          ".form",
          ".vf"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "vertexFrmPreview.open",
        "title": "Open FRM Preview"
      },
      {
        "command": "vertexFrmPreview.sortSections",
        "title": "FRM: Sort sections"
      },
      {
        "command": "vertexFrmPreview.renumberFields",
        "title": "FRM: Renumber fields"
      },
      {
        "command": "vertexFrmPreview.renumberTexts",
        "title": "FRM: Renumber texts"
      },
      {
        "command": "vertexFrmPreview.renumberButtons",
        "title": "FRM: Renumber buttons"
      },
      {
        "command": "vertexFrmPreview.convertPushbuttons",
        "title": "FRM: Convert all pushbuttons to buttons"
      },
      {
        "command": "vertexFrmPreview.zoomIn",
        "title": "FRM: Zoom In"
      },
      {
        "command": "vertexFrmPreview.zoomOut",
        "title": "FRM: Zoom Out"
      },
      {
        "command": "vertexFrmPreview.zoomReset",
        "title": "FRM: Reset Zoom"
      },
      {
        "command": "vertexFrmPreview.zoomFit",
        "title": "FRM: Fit Zoom to Window"
      }
    ],
    "keybindings": [
      {
        "command": "vertexFrmPreview.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "activeWebviewPanelId == 'vertexFrmPreview'"
      },
      {
        "command": "vertexFrmPreview.zoomIn",
        "key": "ctrl+shift+=",
        "mac": "cmd+shift+=",
        "when": "activeWebviewPanelId == 'vertexFrmPreview'"
      },
      {
        "command": "vertexFrmPreview.zoomIn",
        "key": "ctrl+numpad_add",
        "mac": "cmd+numpad_add",
        "when": "activeWebviewPanelId == 'vertexFrmPreview'"
      },
      {
        "command": "vertexFrmPreview.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "activeWebviewPanelId == 'vertexFrmPreview'"
      },
      {
        "command": "vertexFrmPreview.zoomOut",
        "key": "ctrl+numpad_subtract",
        "mac": "cmd+numpad_subtract",
        "when": "activeWebviewPanelId == 'vertexFrmPreview'"
      },
      {
        "command": "vertexFrmPreview.zoomReset",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "activeWebviewPanelId == 'vertexFrmPreview'"
      },
      {
        "command": "vertexFrmPreview.zoomReset",
        "key": "ctrl+numpad0",
        "mac": "cmd+numpad0",
        "when": "activeWebviewPanelId == 'vertexFrmPreview'"
      },
      {
        "command": "vertexFrmPreview.zoomFit",
        "key": "ctrl+1",
        "mac": "cmd+1",
        "when": "activeWebviewPanelId == 'vertexFrmPreview'"
      },
      {
        "command": "vertexFrmPreview.zoomFit",
        "key": "ctrl+numpad1",
        "mac": "cmd+numpad1",
        "when": "activeWebviewPanelId == 'vertexFrmPreview'"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "vertexFrmPreview.zoomIn",
          "when": "false"
        },
        {
          "command": "vertexFrmPreview.zoomOut",
          "when": "false"
        },
        {
          "command": "vertexFrmPreview.zoomReset",
          "when": "false"
        },
        {
          "command": "vertexFrmPreview.zoomFit",
          "when": "false"
        },
        {
          "command": "vertexFrmPreview.sortSections",
          "when": "resourceLangId == vertexfrm || resourceExtname == .frm"
        },
        {
          "command": "vertexFrmPreview.renumberFields",
          "when": "editorLangId == vertexfrm"
        },
        {
          "command": "vertexFrmPreview.renumberTexts",
          "when": "editorLangId == vertexfrm"
        },
        {
          "command": "vertexFrmPreview.renumberButtons",
          "when": "editorLangId == vertexfrm"
        },
        {
          "command": "vertexFrmPreview.convertPushbuttons",
          "when": "editorLangId == vertexfrm"
        }
      ],
      "editor/context": [
        {
          "command": "vertexFrmPreview.sortSections",
          "when": "resourceLangId == vertexfrm || resourceExtname == .frm",
          "group": "1_modification@10"
        }
      ],
      "editor/title": [
        {
          "command": "vertexFrmPreview.open",
          "when": "resourceLangId == vertexfrm",
          "group": "navigation@10"
        }
      ]
    },
    "configuration": {
      "title": "Vertex FRM",
      "properties": {
        "vertexFrmPreview.showZoomControls": {
          "type": "boolean",
          "default": true,
          "description": "Show zoom buttons and slider in the FRM preview titlebar."
        },
        "vertexFrmPreview.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open a preview when an FRM file gets focus and has no preview yet."
        },
        "vertexFrmPreview.autoReveal": {
          "type": "boolean",
          "default": true,
          "description": "Bring an FRM file's existing preview to the front when you switch back to that file."
        },
        "vertexFrmPreview.followCursor": {
          "type": "boolean",
          "default": true,
          "description": "Select the elements at the text cursor or selection in the FRM preview."
        },
        "vertexFrmPreview.diagnostics": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show problems found in FRM files."
        }
      }
    },
    "grammars": [
      {
        "language": "vertexfrm",
        "scopeName": "source.vertexfrm",
        "path": "./syntaxes/vertexfrm.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "comment.line.todo.vertexfrm",
            "settings": {
              "foreground": "#0bc402"
            }
          },
          {
            "scope": "comment.line.problem.vertexfrm",
            "settings": {
              "foreground": "#acc74a"
            }
          },
          {
            "scope": "comment.line.temporary.vertexfrm",
            "settings": {
              "foreground": "#929a75"
            }
          },
          {
            "scope": "comment.line.debug.vertexfrm",
            "settings": {
              "foreground": "#c7784a"
            }
          },
          {
            "scope": "comment.line.old.vertexfrm",
            "settings": {
              "foreground": "#879787"
            }
          },
          {
            "scope": "comment.line.new.vertexfrm",
            "settings": {
              "foreground": "#c3f8c3"
            }
          },
          {
            "scope": "comment.line.question.vertexfrm",
            "settings": {
              "foreground": "#a19311"
            }
          },
          {
            "scope": "comment.line.info.vertexfrm",
            "settings": {
              "foreground": "#2591c4"
            }
          },
          {
            "scope": "variable.string.vertexfrm",
            "settings": {
              "foreground": "#2581b3"
            }
          },
          {
            "scope": "string.hash.vertexfrm",
            "settings": {
              "foreground": "#4FC1FF"
            }
          },
          {
            "scope": "keyword.strsyntax.vertexfrm",
            "settings": {
              "foreground": "#eb8989"
            }
          },
          {
            "scope": "punctuation.separator.semicolon.vertexfrm",
            "settings": {
              "foreground": "#960000"
            }
          }
        ]
      }
    }
  },
  "activationEvents": [
    "onLanguage:vertexfrm",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . -w",
    "package": "vsce package",
    "test": "tsc -p . && node --test \"test/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.10.6",
    "@types/vscode": "^1.85.0",
    "eslint": "^9.39.2",
    "globals": "^17.2.0",
    "jiti": "^2.7.0",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.54.0",
    "vsce": "^2.15.0"
  }
}
